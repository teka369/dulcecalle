# Copy to backend/.env — never commit secrets.
DATABASE_URL=postgresql://dulcecalle:dulcecalle@localhost:5432/dulcecalle?schema=public
# Required. No fallback. Blank or missing → process refuses to boot.
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Comma-separated. Production also always allows https://dulcecalle.vercel.app
CORS_ORIGIN=http://localhost:8080
PORT=3000
NODE_ENV=development

# Cloudinary product images (server-only; never NEXT_PUBLIC_*).
# All three required or image endpoints return 503. Get values from
# Cloudinary Console → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Registration mail. Sender credentials are not the admin inbox.
# Without MAIL_HOST + MAIL_FROM, production refuses new signups (503).
# Dev and tests capture the message instead of sending it.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SECURE=false
# Inbox that receives "please review this signup". Not the SMTP user.
REGISTRATION_ADMIN_EMAIL=
# Public site used inside the emails.
APP_PUBLIC_URL=http://localhost:8080
# Existing login emails allowed to approve or reject. Comma-separated.
PLATFORM_ADMIN_EMAILS=
# Optional Cloudflare Turnstile. Empty = honeypot + rate limit only.
TURNSTILE_SECRET_KEY=

# Copy to backend/.env — never commit secrets.
DATABASE_URL=postgresql://dulcecalle:dulcecalle@localhost:5432/dulcecalle?schema=public
# Required. No fallback. Blank or missing → process refuses to boot.
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Comma-separated. Production also always allows https://dulcecalle.vercel.app
CORS_ORIGIN=http://localhost:8080
PORT=3000
NODE_ENV=development

# Cloudinary product images (server-only; never NEXT_PUBLIC_*).
# All three required or image endpoints return 503. Get values from
# Cloudinary Console → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

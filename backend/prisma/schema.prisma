// DulceCalle PostgreSQL model. Matches DATABASE.md.
// Money is BIGINT integer COP. Never float.
// Do not add columns “just in case”.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// TICKET-A: combo is an explicit product type (never sellable).
/// standard = everything else (sellable product or non-sellable insumo).
enum ProductKind {
  standard
  combo
}

enum MembershipRole {
  owner
  staff
}

enum PaymentKind {
  paid
  partial
  credit
}

enum PayMethod {
  Efectivo
  Nequi
}

enum StockMoveReason {
  inicial
  surtir
  sale
  me_lo_comi
  regalar
  perdido
  devolucion
  adjust
  preparacion
  /// C07 — stock back from a voided sale (refType "reversal").
  anulacion
}

enum CashDirection {
  in
  out
}

enum CashMoveKind {
  sale
  debt_collect
  expense
  retiro
  aporte
  compra
  devolucion
  /// C04 R5b — owner pays saldo a favor back in money.
  reembolso_saldo
  /// C07 — compensating move of a reversal (refType "reversal").
  reverso
}

/// C04 — what reduced (or released) an obligation. `reversal` is reserved for C07.
enum AllocationSource {
  payment
  sale_return
  reversal
  credit_refund
}

/// C07 — what a reversal compensates. expense / initial_debt / cash_move are phase 2.
enum ReversalTarget {
  sale
  customer_payment
  expense
  initial_debt
  cash_move
}

/// C07 / decision 10 — closed list of reasons. `otro` needs reasonText (decision 14).
enum ReversalReason {
  error_digitacion
  cliente_equivocado
  monto_equivocado
  duplicado
  devolucion
  otro
}

/// C04 — `credit` = saldo a favor.
enum AllocationTarget {
  sale
  initial_debt
  credit
}

enum AllocationMode {
  fifo
  explicit
  backfill
  credit_apply
  reversal
}

/// C04 decision 6 — how the rest of a return was settled.
enum ReturnRemainderMode {
  refund
  credit
}

/// C09 §3.1 — one counter per business and kind (decisions 5, 13, 26).
enum SequenceKind {
  sale
  payment
  reversal
  adjustment
  return
}

model User {
  id           String   @id @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships BusinessMembership[]

  @@map("users")
}

model Business {
  id        String   @id @db.Uuid
  name      String
  timezone  String   @default("America/Bogota")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships        BusinessMembership[]
  products           Product[]
  customers          Customer[]
  suppliers          Supplier[]
  settings           Setting[]
  sales              Sale[]
  saleLines          SaleLine[]
  saleReturns        SaleReturn[]
  saleReturnLines    SaleReturnLine[]
  stockMoves         StockMove[]
  cashSessions       CashSession[]
  cashCarries        CashCarry[]
  cashMoves          CashMove[]
  expenses           Expense[]
  customerPayments   CustomerPayment[]
  initialDebts       InitialDebt[]
  debtAllocations    DebtAllocation[]
  importIdMap        ImportIdMap[]
  productImages      ProductImage[]
  preparations       Preparation[]
  reversals          Reversal[]
  sequences          BusinessSequence[]
  receipts           Receipt[]

  @@map("businesses")
}

model BusinessMembership {
  id         String         @id @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  role       MembershipRole
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
  @@map("business_memberships")
}

model Product {
  id            String    @id @db.Uuid
  businessId    String    @map("business_id") @db.Uuid
  name          String
  category      String    @default("General")
  price         BigInt
  avgCost       BigInt    @map("avg_cost")
  stock         Int
  lowStockAt    Int       @map("low_stock_at")
  /** False = supply/combo: purchasable and preparable, never sold directly. */
  sellable      Boolean   @default(true)
  /** TICKET-A: combo forces sellable=false and is the only preparation source. */
  kind          ProductKind @default(standard)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  legacyDexieId Int?      @map("legacy_dexie_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  requestId     String?   @map("request_id") @db.Uuid

  business   Business    @relation(fields: [businessId], references: [id])
  saleLines  SaleLine[]
  stockMoves StockMove[]
  returnLines SaleReturnLine[]
  images     ProductImage[]
  preparedFrom Preparation[] @relation("PreparationSource")
  preparedInto Preparation[] @relation("PreparationTarget")

  @@unique([businessId, requestId])
  @@unique([businessId, legacyDexieId])
  @@index([businessId])
  @@map("products")
}

model Customer {
  id            String    @id @db.Uuid
  businessId    String    @map("business_id") @db.Uuid
  code          String
  name          String
  phone         String?
  debt          BigInt    @default(0)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  legacyDexieId Int?      @map("legacy_dexie_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  requestId     String?   @map("request_id") @db.Uuid
  /** bcrypt of the 6-digit portal PIN. Null means the portal cannot log in. */
  pinHash       String?   @map("pin_hash")
  /// C04 — saldo a favor cache (= Σ allocations with target credit). CHECK ≥ 0.
  creditBalance BigInt    @default(0) @map("credit_balance")

  business    Business           @relation(fields: [businessId], references: [id])
  sales       Sale[]
  payments    CustomerPayment[]
  initials    InitialDebt[]
  allocations DebtAllocation[]

  @@unique([businessId, code])
  @@unique([businessId, requestId])
  @@unique([businessId, legacyDexieId])
  @@index([businessId, debt])
  @@map("customers")
}

model Supplier {
  id            String   @id @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  name          String
  phone         String?
  notes         String?
  legacyDexieId Int?     @map("legacy_dexie_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  requestId     String?  @map("request_id") @db.Uuid

  business   Business    @relation(fields: [businessId], references: [id])
  stockMoves StockMove[]

  @@unique([businessId, requestId])
  @@unique([businessId, legacyDexieId])
  @@map("suppliers")
}

model Setting {
  businessId String @map("business_id") @db.Uuid
  key        String
  value      String

  business Business @relation(fields: [businessId], references: [id])

  @@id([businessId, key])
  @@map("settings")
}

model Sale {
  id              String       @id @db.Uuid
  businessId      String       @map("business_id") @db.Uuid
  customerId      String?      @map("customer_id") @db.Uuid
  paymentKind     PaymentKind  @map("payment_kind")
  method          PayMethod?
  saleTotal       BigInt       @map("sale_total")
  amountReceived  BigInt       @map("amount_received")
  credit          BigInt
  requestId       String?      @map("request_id") @db.Uuid
  legacyRequestId String?      @map("legacy_request_id")
  /// C02 — sha256 of the canonical create payload bound to request_id.
  payloadHash     String?      @map("payload_hash")
  note            String?
  occurredOn      DateTime     @map("occurred_on") @db.Date
  /// C03 / DC-06: when the sale happened on the device, if sent.
  occurredAt      DateTime?    @map("occurred_at") @db.Timestamptz(3)
  /// C03 / DC-06: when the server accepted the sale.
  syncedAt        DateTime?    @map("synced_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  legacyDexieId   Int?         @map("legacy_dexie_id")
  /// C09 — DC-000001 per business (business_sequences kind sale).
  number          Int?

  business Business   @relation(fields: [businessId], references: [id])
  customer Customer?  @relation(fields: [customerId], references: [id])
  lines    SaleLine[]
  returns  SaleReturn[]
  allocations DebtAllocation[]

  @@unique([businessId, requestId])
  @@unique([businessId, legacyDexieId])
  @@unique([businessId, number])
  @@index([businessId, occurredOn])
  @@index([businessId, customerId])
  @@map("sales")
}

model SaleLine {
  id            String @id @db.Uuid
  businessId    String @map("business_id") @db.Uuid
  saleId        String @map("sale_id") @db.Uuid
  productId     String @map("product_id") @db.Uuid
  productName   String @map("product_name")
  qty           Int
  unitPrice     BigInt @map("unit_price")
  unitCost      BigInt @map("unit_cost")
  lineTotal     BigInt @map("line_total")
  legacyDexieId Int?   @map("legacy_dexie_id")

  business    Business         @relation(fields: [businessId], references: [id])
  sale        Sale             @relation(fields: [saleId], references: [id])
  product     Product          @relation(fields: [productId], references: [id])
  returnLines SaleReturnLine[]

  @@unique([businessId, legacyDexieId])
  @@index([businessId, saleId])
  @@map("sale_lines")
}

model SaleReturn {
  id            String     @id @db.Uuid
  businessId    String     @map("business_id") @db.Uuid
  saleId        String     @map("sale_id") @db.Uuid
  refundAmount  BigInt     @map("refund_amount")
  debtReduced   BigInt     @map("debt_reduced")
  method        PayMethod?
  requestId     String?    @map("request_id") @db.Uuid
  note          String?
  occurredOn    DateTime   @map("occurred_on") @db.Date
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  legacyDexieId Int?       @map("legacy_dexie_id")
  /// C04 decision 15 — offline return without a remainder choice: rest left as saldo a favor.
  needsReview   Boolean    @default(false) @map("needs_review")
  /// C04 decision 6 — how the rest (value − debtReduced) was settled; null when there was no rest.
  remainderMode ReturnRemainderMode? @map("remainder_mode")

  business Business         @relation(fields: [businessId], references: [id])
  sale     Sale             @relation(fields: [saleId], references: [id])
  lines    SaleReturnLine[]

  @@unique([businessId, requestId])
  @@unique([businessId, legacyDexieId])
  @@index([businessId, occurredOn])
  @@index([businessId, saleId])
  @@map("sale_returns")
}

model SaleReturnLine {
  id            String @id @db.Uuid
  businessId    String @map("business_id") @db.Uuid
  returnId      String @map("return_id") @db.Uuid
  saleLineId    String @map("sale_line_id") @db.Uuid
  productId     String @map("product_id") @db.Uuid
  qty           Int
  unitPrice     BigInt @map("unit_price")
  unitCost      BigInt @map("unit_cost")
  legacyDexieId Int?   @map("legacy_dexie_id")

  business Business  @relation(fields: [businessId], references: [id])
  ret      SaleReturn @relation(fields: [returnId], references: [id])
  saleLine SaleLine   @relation(fields: [saleLineId], references: [id])
  product  Product    @relation(fields: [productId], references: [id])

  @@unique([businessId, legacyDexieId])
  @@map("sale_return_lines")
}

model StockMove {
  id            String           @id @db.Uuid
  businessId    String           @map("business_id") @db.Uuid
  productId     String           @map("product_id") @db.Uuid
  delta         Int
  reason        StockMoveReason
  unitCost      BigInt           @map("unit_cost")
  supplierId    String?          @map("supplier_id") @db.Uuid
  refType       String?          @map("ref_type")
  refId         String?          @map("ref_id") @db.Uuid
  note          String?
  requestId     String?          @map("request_id") @db.Uuid
  occurredOn    DateTime         @map("occurred_on") @db.Date
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  legacyDexieId Int?             @map("legacy_dexie_id")

  business Business @relation(fields: [businessId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@unique([businessId, requestId])
  @@unique([businessId, legacyDexieId])
  @@index([businessId, occurredOn])
  @@index([businessId, productId, createdAt])
  @@map("stock_moves")
}

model CashSession {
  id               String    @id @db.Uuid
  businessId       String    @map("business_id") @db.Uuid
  localDate        DateTime  @map("local_date") @db.Date
  openedAt         DateTime  @map("opened_at") @db.Timestamptz(3)
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(3)
  openingFloat     BigInt    @map("opening_float")
  closingCount     BigInt?   @map("closing_count")
  expectedEfectivo BigInt?   @map("expected_efectivo")
  expectedNequi    BigInt?   @map("expected_nequi")
  difference       BigInt?
  closeMode        String?   @map("close_mode")
  carriedEfectivo  BigInt    @default(0) @map("carried_efectivo")
  note             String?
  requestId        String?   @map("request_id") @db.Uuid
  closeRequestId   String?   @map("close_request_id") @db.Uuid
  /// C01: closed with N rejected money operations still unresolved on a device («Cerrar igual»).
  unresolvedCount  Int?      @map("unresolved_count")
  unresolvedAmount BigInt?   @map("unresolved_amount")
  legacyDexieId    Int?      @map("legacy_dexie_id")

  business      Business    @relation(fields: [businessId], references: [id])
  moves         CashMove[]  @relation("SessionMoves")
  pendingMoves  CashMove[]  @relation("PendingForSession")

  @@unique([businessId, localDate])
  @@unique([businessId, requestId])
  @@unique([businessId, closeRequestId])
  @@unique([businessId, legacyDexieId])
  @@map("cash_sessions")
}

model CashMove {
  id            String        @id @db.Uuid
  businessId    String        @map("business_id") @db.Uuid
  amount        BigInt
  direction     CashDirection
  method        PayMethod
  kind          CashMoveKind
  sessionId     String?       @map("session_id") @db.Uuid
  refType       String?       @map("ref_type")
  refId         String?       @map("ref_id") @db.Uuid
  requestId     String?       @map("request_id") @db.Uuid
  note          String?
  occurredOn    DateTime      @map("occurred_on") @db.Date
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  legacyDexieId Int?          @map("legacy_dexie_id")

  pendingForSessionId String? @map("pending_for_session_id") @db.Uuid
  /// C01: received after its day was closed and not yet assigned to a caja.
  needsReview         Boolean @default(false) @map("needs_review")

  business         Business     @relation(fields: [businessId], references: [id])
  session          CashSession? @relation("SessionMoves", fields: [sessionId], references: [id])
  pendingForSession CashSession? @relation("PendingForSession", fields: [pendingForSessionId], references: [id])

  @@unique([businessId, requestId])
  @@unique([businessId, legacyDexieId])
  @@index([businessId, occurredOn])
  @@index([businessId, pendingForSessionId])
  @@map("cash_moves")
}

model CashCarry {
  id                String   @id @db.Uuid
  businessId        String   @map("business_id") @db.Uuid
  requestId         String   @map("request_id") @db.Uuid
  previousSessionId String?  @map("previous_session_id") @db.Uuid
  currentSessionId  String   @map("current_session_id") @db.Uuid
  mode              String
  countedEfectivo   BigInt?  @map("counted_efectivo")
  openingFloat      BigInt   @map("opening_float")
  reassignedCount   Int      @map("reassigned_count")
  reassignedIds     String[] @default([]) @map("reassigned_ids")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, requestId])
  @@map("cash_carries")
}

model Expense {
  id            String    @id @db.Uuid
  businessId    String    @map("business_id") @db.Uuid
  amount        BigInt
  category      String
  note          String?
  method        PayMethod
  requestId     String?   @map("request_id") @db.Uuid
  occurredOn    DateTime  @map("occurred_on") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  legacyDexieId Int?      @map("legacy_dexie_id")

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, requestId])
  @@unique([businessId, legacyDexieId])
  @@index([businessId, occurredOn])
  @@map("expenses")
}

model CustomerPayment {
  id            String    @id @db.Uuid
  businessId    String    @map("business_id") @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  amount        BigInt
  method        PayMethod
  /// OBSOLETE (C04): always null. A payment may be split across several sales;
  /// use debt_allocations. Kept (not dropped, not reused).
  saleId        String?   @map("sale_id") @db.Uuid
  requestId     String?   @map("request_id") @db.Uuid
  note          String?
  occurredOn    DateTime  @map("occurred_on") @db.Date
  /// C01/C03: when the money was actually received (device clock), if sent.
  occurredAt    DateTime? @map("occurred_at") @db.Timestamptz(3)
  /// C03 / DC-06: when the server accepted the abono.
  syncedAt      DateTime? @map("synced_at") @db.Timestamptz(3)
  /// C01: accepted after its day was closed; shown as «De otro día» / requires review.
  needsReview   Boolean   @default(false) @map("needs_review")
  /// C02 — sha256 of the canonical abono payload bound to request_id.
  payloadHash   String?   @map("payload_hash")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  legacyDexieId Int?      @map("legacy_dexie_id")
  /// C04 — seller intent ({mode:"fifo"} | {mode:"sale",saleId} | {mode:"split",targets}) + overflow. Audit.
  requestedTarget    Json?     @map("requested_target")
  /// C04 §6.4 — allocation response snapshot (openBefore/openAfter, debt before/after) so a replay is identical.
  allocationResult   Json?     @map("allocation_result")
  /// C04 §6.3 — the requested sale was already settled; applied elsewhere.
  allocationAdjusted Boolean   @default(false) @map("allocation_adjusted")
  adjustedReviewedAt DateTime? @map("adjusted_reviewed_at") @db.Timestamptz(3)
  adjustedReviewedBy String?   @map("adjusted_reviewed_by") @db.Uuid
  /// C07 «corregir» (decision 21). Unused in C04.
  replacesPaymentId  String?   @map("replaces_payment_id") @db.Uuid
  /// C09 — DC-P-000001 per business (business_sequences kind payment).
  number             Int?

  business Business @relation(fields: [businessId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([businessId, requestId])
  @@unique([businessId, legacyDexieId])
  @@unique([businessId, number])
  @@index([businessId, occurredOn])
  @@index([businessId, customerId])
  @@map("customer_payments")
}

model InitialDebt {
  id            String   @id @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  amount        BigInt
  note          String?
  requestId     String?  @map("request_id") @db.Uuid
  occurredOn    DateTime @map("occurred_on") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  legacyDexieId Int?     @map("legacy_dexie_id")

  business    Business         @relation(fields: [businessId], references: [id])
  customer    Customer         @relation(fields: [customerId], references: [id])
  allocations DebtAllocation[]

  @@unique([businessId, requestId])
  @@unique([businessId, legacyDexieId])
  @@index([businessId, customerId])
  @@map("initial_debts")
}

/// C04 — one row per piece of a source (payment / return / credit refund)
/// applied to an obligation (sale / initial debt) or to saldo a favor.
/// Signed amount: > 0 applies, < 0 releases (credit_apply pair, refund).
/// Rows are never updated or deleted (only the business wipe deletes them).
/// CHECKs in SQL: exactly one target by target_type; amount <> 0.
model DebtAllocation {
  id            String           @id @db.Uuid
  businessId    String           @map("business_id") @db.Uuid
  customerId    String           @map("customer_id") @db.Uuid
  sourceType    AllocationSource @map("source_type")
  sourceId      String           @map("source_id") @db.Uuid
  targetType    AllocationTarget @map("target_type")
  saleId        String?          @map("sale_id") @db.Uuid
  initialDebtId String?          @map("initial_debt_id") @db.Uuid
  amount        BigInt
  mode          AllocationMode
  groupId       String           @map("group_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String?          @map("created_by") @db.Uuid
  /// C07 — only on reversal rows: the source whose money this row moves (I-A1 per source).
  originSourceType AllocationSource? @map("origin_source_type")
  originSourceId   String?           @map("origin_source_id") @db.Uuid

  business    Business     @relation(fields: [businessId], references: [id])
  customer    Customer     @relation(fields: [customerId], references: [id])
  sale        Sale?        @relation(fields: [saleId], references: [id])
  initialDebt InitialDebt? @relation(fields: [initialDebtId], references: [id])

  @@index([businessId, customerId])
  @@index([businessId, saleId])
  @@index([businessId, sourceType, sourceId])
  @@map("debt_allocations")
}

/// C07 — one compensating reversal (anulación) of a sale or a payment.
/// Never updated or deleted (only the business wipe deletes it).
/// The target is «anulado» iff a row exists (derived state, no mutable column).
model Reversal {
  id            String         @id @db.Uuid
  businessId    String         @map("business_id") @db.Uuid
  /// DC-R-000001, per business (decision 13).
  number        String
  targetType    ReversalTarget @map("target_type")
  targetId      String         @map("target_id") @db.Uuid
  reasonCode    ReversalReason @map("reason_code")
  reasonText    String?        @map("reason_text")
  oldConfirmed  Boolean        @default(false) @map("old_confirmed")
  requestedBy   String         @map("requested_by") @db.Uuid
  /// Operating day of the reversal (today), never the original's day.
  occurredOn    DateTime       @map("occurred_on") @db.Date
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  requestId     String         @map("request_id") @db.Uuid
  payloadHash   String         @map("payload_hash")
  /// Snapshot before: debt, saldo a favor, open balances, stock, caja.
  before        Json
  /// Snapshot after + the effects (cash/stock moves, allocations).
  after         Json
  /// «Corregir abono»: id of the replacement payment (decision 21).
  replacementId String?        @map("replacement_id") @db.Uuid

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, targetType, targetId])
  @@unique([businessId, requestId])
  @@unique([businessId, number])
  @@index([businessId, occurredOn])
  @@map("reversals")
}

model ImportIdMap {
  businessId String @map("business_id") @db.Uuid
  tableName  String @map("table_name")
  dexieId    Int    @map("dexie_id")
  pgId       String @map("pg_id") @db.Uuid

  business Business @relation(fields: [businessId], references: [id])

  @@id([businessId, tableName, dexieId])
  @@map("import_id_map")
}

model ProductImage {
  id                String    @id @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  cloudinaryAssetId String?   @map("cloudinary_asset_id")
  publicId          String    @map("public_id")
  secureUrl         String    @map("secure_url")
  version           Int?
  width             Int?
  height            Int?
  format            String?
  bytes             Int?
  position          Int       @default(0)
  isPrimary         Boolean   @default(false) @map("is_primary")
  altText           String?   @map("alt_text")
  requestId         String?   @map("request_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([publicId])
  @@unique([businessId, requestId])
  @@index([businessId, productId, position])
  @@map("product_images")
}

/**
 * Preparation (Producción): one transformation of a supply/combo product
 * into finished units of another product. Immutable history — errors are
 * compensated with existing tools (shrink on finished stock), never by
 * deleting. The source lot is NOT decremented (its total yield is unknown
 * at purchase); the record itself is the consumption trace. Assigned cost
 * is explicit per preparation (0 = pending, gifted semantics); the source
 * lot keeps its own value. No cash moves: money left at purchase (surtir).
 */
model Preparation {
  id         String   @id @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  sourceId   String   @map("source_id") @db.Uuid
  targetId   String   @map("target_id") @db.Uuid
  qty        Int
  /** Assigned cost per finished unit. null = pending/unknown (average untouched). 0 = real zero. */
  unitCost   BigInt?  @map("unit_cost")
  note       String?
  requestId  String?  @map("request_id") @db.Uuid
  occurredOn DateTime @map("occurred_on") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])
  source   Product  @relation("PreparationSource", fields: [sourceId], references: [id])
  target   Product  @relation("PreparationTarget", fields: [targetId], references: [id])

  @@unique([businessId, requestId])
  @@index([businessId, sourceId, createdAt])
  @@index([businessId, targetId, createdAt])
  @@map("preparations")
}

/// Server-side refresh session. The raw refresh token is never stored.
model AuthSession {
  id         String    @id @db.Uuid
  kind       String
  subjectId  String    @map("subject_id") @db.Uuid
  businessId String?   @map("business_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)

  @@index([subjectId, kind])
  @@map("auth_sessions")
}

/// Per customer-code cooldown for the portal PIN. Not an IP bucket and not a permanent lock.
model PortalLoginThrottle {
  id            String    @id @db.Uuid
  bucket        String    @unique
  failures      Int
  windowStart   DateTime  @map("window_start") @db.Timestamptz(3)
  cooldownUntil DateTime? @map("cooldown_until") @db.Timestamptz(3)

  @@map("portal_login_throttles")
}

/// C01.1 / C01-INV-04 — server copy of client-side rejections and discards
/// of money operations, so the trace survives the device. One row per
/// (business, operation, kind); replays are idempotent.
model ClientOpEvent {
  id              String    @id @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  operationId     String    @map("operation_id") @db.Uuid
  requestId       String?   @map("request_id") @db.Uuid
  entity          String
  operation       String
  kind            String
  amount          BigInt?
  customerId      String?   @map("customer_id") @db.Uuid
  rejectionCode   String?   @map("rejection_code")
  lastError       String?   @map("last_error")
  replacedBy      String?   @map("replaced_by") @db.Uuid
  deviceCreatedAt DateTime? @map("device_created_at") @db.Timestamptz(3)
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([businessId, operationId, kind])
  @@index([businessId, createdAt])
  @@map("client_op_events")
}

/// C09 §3.1 — `next` is the number the next row of that kind gets. Bumped
/// inside the creating transaction (a rollback undoes it: no gaps). Never reset.
model BusinessSequence {
  businessId String       @map("business_id") @db.Uuid
  kind       SequenceKind
  next       BigInt       @default(1)
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])

  @@id([businessId, kind])
  @@map("business_sequences")
}

/// C09 §2 — receipt kinds (separate receipts; allocation/reversal from PR3, adjustment reserved).
enum ReceiptKind {
  sale
  payment
  allocation
  reversal
  adjustment
  return
}

/// C09 §3.2 — verifiable receipt. INSERT-ONLY (DB trigger `receipts_insert_only`,
/// the business wipe included). `contentHash` = sha256 of the canonical snapshot.
/// No FK to customer/source on purpose: the receipt outlives a wipe of its source.
model Receipt {
  id            String      @id @db.Uuid
  businessId    String      @map("business_id") @db.Uuid
  customerId    String?     @map("customer_id") @db.Uuid
  kind          ReceiptKind
  sourceType    String      @map("source_type")
  sourceId      String      @map("source_id") @db.Uuid
  number        String
  verifyCode    String      @unique @map("verify_code") @db.VarChar(10)
  snapshot      Json
  contentHash   String      @map("content_hash")
  prevReceiptId String?     @map("prev_receipt_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])
  prev     Receipt?  @relation("ReceiptVersions", fields: [prevReceiptId], references: [id])
  next     Receipt[] @relation("ReceiptVersions")

  @@unique([businessId, kind, sourceId])
  @@unique([businessId, number])
  @@index([businessId, customerId, createdAt])
  @@index([businessId, createdAt])
  @@map("receipts")
}
